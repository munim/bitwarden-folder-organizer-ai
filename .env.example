# Example environment variables for organize-bitwarden-folders-ai
#
# Copy this file to `.env` and fill in values:
#   cp .env.example .env
#
# Never commit your real `.env`.

# LLM provider API keys (choose one provider in CLI via --provider)
OPENROUTER_API_KEY=
REQUESTY_API_KEY=

# Bitwarden session token
#
# Recommended: export a short-lived session in your shell instead of storing it in a file:
#   export BW_SESSION="$(bw unlock --raw)"
#
# If you really want, you can put it here (the code will also read BW_SESSION from env).
BW_SESSION=
